{
  "$schema": "orca-brand-tokens-v1",
  "brand": "Orca",
  "product": "Orca Keel",
  "version": "0.2 (2026-10-21; vector mark from the Orca Solutions Signal v1.0 package; neutrals aligned to the studio's Ink and Chalk)",
  "color": {
    "harbor": {
      "paper": {
        "value": "#F0EEE7",
        "role": "Ground: pages, carton, app background. The studio's Chalk; named Paper in the product"
      },
      "white": {
        "value": "#FFFFFF",
        "role": "Surface: cards on Paper"
      },
      "ink": {
        "value": "#171A18",
        "role": "Text, the mark, the box itself, the installer's dark section. The studio's Ink"
      },
      "harbor": {
        "value": "#1E5A66",
        "role": "Accent: links, selected states, one emphasis per screen. 7.0:1 on Paper"
      },
      "stone": {
        "value": "#6B6760",
        "role": "Secondary text, captions, labels. 4.9:1 on Paper"
      },
      "linen": {
        "value": "#E2DFD6",
        "role": "Rules, borders, dividers"
      },
      "amber": {
        "value": "#C8862B",
        "role": "Signal: the listening light only. Never text, never a fill"
      },
      "paper-on-ink": {
        "value": "#CFCBC2",
        "role": "Secondary text on Ink"
      },
      "vermilion": {
        "value": "#E65032",
        "role": "The studio's accent (Orca Solutions). Not used on the products; the products' signal is Amber"
      }
    },
    "workshop": {
      "white": {
        "value": "#FFFFFF",
        "role": "Ground"
      },
      "black": {
        "value": "#111111",
        "role": "Text, the mark, the box"
      },
      "graphite": {
        "value": "#3D3D3D",
        "role": "Secondary surfaces, rules on dark"
      },
      "grey": {
        "value": "#6A6A6A",
        "role": "Secondary text. 5.2:1 on White"
      },
      "hairline": {
        "value": "#E6E6E6",
        "role": "Rules, borders"
      },
      "signal": {
        "value": "#D8441C",
        "role": "The listening light only"
      }
    }
  },
  "type": {
    "family": {
      "product": {
        "value": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "role": "The product's voice: wordmark, interface, buttons, carton, headings",
        "source": "Google Fonts, weights 400 500 600"
      },
      "record": {
        "value": "'Newsreader', Georgia, 'Times New Roman', serif",
        "role": "The record's voice: Daybook entries, matters, long copy, the card's steps",
        "source": "Google Fonts, optical size 6..72, weights 400 500, italic 400"
      },
      "mono": {
        "value": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
        "role": "Installer documentation only"
      }
    },
    "scale": {
      "display-1": {
        "size": 56,
        "line": 1.02,
        "weight": 600,
        "tracking": "-0.025em",
        "family": "product"
      },
      "display-2": {
        "size": 40,
        "line": 1.05,
        "weight": 600,
        "tracking": "-0.02em",
        "family": "product"
      },
      "display-3": {
        "size": 32,
        "line": 1.08,
        "weight": 600,
        "tracking": "-0.02em",
        "family": "product"
      },
      "title": {
        "size": 24,
        "line": 1.15,
        "weight": 600,
        "tracking": "-0.02em",
        "family": "product"
      },
      "lead": {
        "size": 21,
        "line": 1.4,
        "weight": 400,
        "tracking": "0",
        "family": "record"
      },
      "body": {
        "size": 17,
        "line": 1.45,
        "weight": 400,
        "tracking": "0",
        "family": "record"
      },
      "ui": {
        "size": 16,
        "line": 1.4,
        "weight": 500,
        "tracking": "0",
        "family": "product"
      },
      "ui-small": {
        "size": 14,
        "line": 1.45,
        "weight": 400,
        "tracking": "0",
        "family": "product"
      },
      "caption": {
        "size": 13,
        "line": 1.45,
        "weight": 400,
        "tracking": "0",
        "family": "product"
      },
      "label": {
        "size": 13,
        "line": 1.2,
        "weight": 500,
        "tracking": "0.08em",
        "family": "product",
        "transform": "uppercase"
      }
    }
  },
  "space": {
    "unit": 4,
    "steps": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      48,
      64,
      80
    ],
    "page-gutter": 24,
    "content-max": 1120,
    "section": 80
  },
  "radius": {
    "control": 6,
    "card": 8,
    "panel": 10,
    "icon": "23.4% of the icon's side"
  },
  "mark": {
    "clear-space": "half the head's height on all sides",
    "minimum": {
      "print": "8 mm",
      "screen": "24 px"
    },
    "seal": {
      "box": "debossed, tone on tone, about 18 mm, top surface, beside the amber light",
      "carton": "blind-embossed in the board, no ink",
      "paper": "printed in Ink, alone, never inside a ring, plate or badge"
    },
    "eye": "always a hole showing the ground; never a white fill",
    "status": "Vector master: Orca Solutions Signal v1.0 (September 27, 2026), source/geometry.json. Primary path for 32 px and up; micro path (orca-head-micro-*.svg) for 16 to 31 px and favicons",
    "name": "Signal"
  },
  "light": {
    "idle": "off",
    "listening": "amber, steady",
    "setup": "amber, one blink on power",
    "rule": "the only lit element on the hardware"
  }
}